# Neon PostgreSQL
#
# REGION: keep the database in the SAME region as the API. Measured from India:
#   us-east-2 (Ohio)        276 ms per round trip
#   ap-southeast-1 (SG)      93 ms
# The API runs in Render's Singapore region, so the database belongs there too.
# A three-query page loses half a second to a cross-region database and no
# frontend work recovers it.

# Pooled — used at runtime by the API and by Prisma Client.
#
# NOTE: no `pgbouncer=true`. That flag disables prepared statements, which
# classic PgBouncer in transaction mode requires but Neon's pooler does not.
# Measured at 24-way concurrency over 192 queries: 192/192 succeeded both with
# and without it, at 64 ms/query vs 20 ms/query. It was costing ~3x for nothing.
#
# If `prepared statement "s0" already exists` ever appears in the logs, add
# `&pgbouncer=true` back — that error is the exact failure it prevents.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/schooltocareer?sslmode=require"

# Unpooled/direct — used by `prisma migrate`, `prisma studio`, the
# concurrent-index script, and any bulk write. PgBouncer transaction pooling
# breaks advisory locks and DDL, so migrations MUST NOT use the pooled URL.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/schooltocareer?sslmode=require"

# Shadow database for `prisma migrate dev` (a separate Neon branch).
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@ep-yyy.REGION.aws.neon.tech/shadow?sslmode=require"
