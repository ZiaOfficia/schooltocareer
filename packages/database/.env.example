# Neon PostgreSQL
# Pooled (PgBouncer) — used at runtime by the API and by Prisma Client.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/schooltocareer?sslmode=require&pgbouncer=true&connection_limit=1"

# Unpooled/direct — used by `prisma migrate`, `prisma studio` and the
# concurrent-index script. PgBouncer transaction pooling breaks advisory locks
# and DDL, so migrations MUST NOT use the pooled URL.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/schooltocareer?sslmode=require"

# Shadow database for `prisma migrate dev` (a separate Neon branch).
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@ep-yyy.REGION.aws.neon.tech/shadow?sslmode=require"
