{
  "name": "@stc/database",
  "version": "1.0.0",
  "private": true,
  "description": "SchoolToCareer - Prisma schema, client singleton and seeds. Schema v1.0-launch.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "db:migrate:dev": "node ../../tooling/scripts/guard-migrate-dev.mjs migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:constraints": "tsx ../../tooling/scripts/apply-concurrent-indexes.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:reset": "node ../../tooling/scripts/guard-migrate-dev.mjs migrate reset --skip-seed",
    "validate": "prisma validate",
    "format": "prisma format",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "schema": "prisma/schema",
    "seed": "tsx prisma/seed/index.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "@stc/constants": "workspace:*",
    "@stc/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "prisma": "^6.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
