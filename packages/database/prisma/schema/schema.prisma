// ---------------------------------------------------------------------------
// SchoolToCareer — Schema v1.0-LAUNCH  (30 models)
//
// SCOPE: this is the deliberately reduced launch cut. The full 89-model design
// is preserved at docs/architecture/schema-full-v1/ and is the roadmap for:
//   Phase 2 — Careers, Colleges, Courses, Scholarships, Jobs, cutoffs, tags,
//             answer keys, media folders/links, RBAC tables, internal linking
//   Phase 3 — Analytics, AI, embeddings, translations, real multi-site
//
// Everything deferred is ADDITIVE. The one thing kept early despite being
// unused is `siteId`, because it lives inside composite unique constraints —
// adding a column to a populated table is trivial, altering a unique index on
// one is not.
//
// Constraints PostgreSQL supports but Prisma cannot express live in
//   prisma/migrations/manual/001_raw_constraints.sql
// ---------------------------------------------------------------------------

// Default output (node_modules/.prisma/client) on purpose: it keeps
// `@prisma/client` a normal external dependency, so the API bundler can mark it
// external instead of trying to bundle the query engine binary.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder", "relationJoins", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")        // Neon POOLED (PgBouncer) — runtime
  directUrl  = env("DIRECT_DATABASE_URL") // Neon UNPOOLED — migrations only
  extensions = [pg_trgm, unaccent]
}

// ── Publishing ─────────────────────────────────────────────────────────────

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentType {
  ARTICLE
  NEWS
  NOTE
  SYLLABUS
  GUIDE
  STATIC_PAGE
}

/// Owner discriminator for the CLOSED allowlist of polymorphic tables:
/// ContentRevision, ContentDraft, FaqItem, PageSection, SlugHistory,
/// SearchDocument, OutboxEvent.
/// Adding this field pair to any OTHER model is an ESLint error.
/// Values for deferred entities (COLLEGE, COURSE, CAREER…) are intentionally
/// present so Phase 2 adds tables, not enum migrations.
enum OwnerType {
  BOARD
  BOARD_CLASS
  BOARD_CLASS_SUBJECT
  CHAPTER
  SUBJECT
  EXAM
  EXAM_YEAR
  QUESTION_PAPER
  RESULT
  CONTENT_ENTRY
  CATEGORY
  COLLEGE
  COURSE
  CAREER
  SCHOLARSHIP
  JOB
  /// Added for the Media module (Phase 5). Purely additive.
  /// MIGRATION NOTE: PostgreSQL cannot USE a new enum value in the same
  /// transaction that ADDs it, and Prisma wraps migrations in a transaction.
  /// This value must therefore ship in its own migration, before any migration
  /// or backfill that writes it.
  MEDIA_ASSET
}

enum Locale {
  EN
  HI
}

