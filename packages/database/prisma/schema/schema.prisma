// ── Identity ───────────────────────────────────────────────────────────────

/// A single enum column replaces the four-table RBAC design for launch.
/// Phase 2 swaps this for Role/Permission/RolePermission/UserRole; the
/// migration is additive because authorisation is already funnelled through
/// one `can(user, 'exam:publish')` helper.
enum UserRole {
  ADMIN
  EDITOR
  AUTHOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

// ── Editorial ──────────────────────────────────────────────────────────────

enum RevisionType {
  MANUAL
  PUBLISHED
