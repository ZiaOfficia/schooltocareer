  IMPORT
}

enum SlugChangeReason {
  MANUAL_RENAME
  NORMALIZATION
  MERGE
  SOFT_DELETE
  RESTORE
  IMPORT_CORRECTION
}

// ── Platform ───────────────────────────────────────────────────────────────

enum OutboxEventType {
  SEARCH_UPSERT
  SEARCH_DELETE
  CACHE_REVALIDATE
  SITEMAP_PING
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
  DEAD
}
