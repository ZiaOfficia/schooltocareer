// ---------------------------------------------------------------------------
// SchoolToCareer — Schema v1.0 (FROZEN)
// Base: datasource, generator, and every shared enum.
//
// Conventions applied across all domain files:
//   id          String   @id @default(cuid())      — entities & content
//   id          BigInt   @id @default(autoincrement()) — append-only tables
//   status      PublishStatus @default(DRAFT)
//   createdAt / updatedAt                          — always
//   createdById / updatedById                      — UNCONSTRAINED columns (no FK).
//                                                    Real audit trail lives in AuditLog.
//   deletedAt   DateTime?                          — user-facing rows only.
//                                                    Never on join tables, revisions, logs.
//
// Constraints that PostgreSQL supports but Prisma cannot express live in
//   prisma/migrations/manual/001_raw_constraints.sql
// ---------------------------------------------------------------------------

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder", "relationJoins", "postgresqlExtensions"]
  output          = "../../src/generated/client"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")        // Neon POOLED (PgBouncer) — runtime
  directUrl  = env("DIRECT_DATABASE_URL") // Neon UNPOOLED — migrations only
  extensions = [pg_trgm, unaccent, vector]
}

