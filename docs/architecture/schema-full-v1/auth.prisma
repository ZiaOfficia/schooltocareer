// ---------------------------------------------------------------------------
// AUTH — identity, sessions, RBAC, audit trail.
//
// Referential actions: Cascade on identity-owned rows (a deleted user really
// loses their sessions and role links). SetNull on AuditLog.actorId — the
// audit record must outlive the actor.
// ---------------------------------------------------------------------------

model User {
  id              String     @id @default(cuid())
  email           String     @unique // tombstoned on soft delete — see README
  emailVerifiedAt DateTime?
  passwordHash    String?
  name            String
  slug            String?    @unique // /author/[slug]
  bio             String?    @db.Text
  designation     String?
  avatarUrl       String?
  locale          Locale     @default(EN)
  status          UserStatus @default(ACTIVE)
  lastLoginAt     DateTime?

  roles           UserRole[]
  accounts        Account[]
  sessions        Session[]
  authoredEntries ContentEntry[]    @relation("ContentAuthor")
  reviewedEntries ContentEntry[]    @relation("ContentReviewer")
  lockedEntries   ContentEntry[]    @relation("ContentLock")
  revisions       ContentRevision[]
  drafts          ContentDraft[]
  uploads         MediaAsset[]
  auditLogs       AuditLog[]
  savedItems      SavedItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status, deletedAt])
  @@index([deletedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  provider          String // "google"
  providerAccountId String
  refreshToken      String? @db.Text
  accessToken       String? @db.Text
  expiresAt         Int?
  scope             String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  refreshToken String    @unique // hashed
  userAgent    String?
  ipHash       String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model VerificationToken {
  id         String    @id @default(cuid())
  identifier String
  tokenHash  String    @unique
  type       String // EMAIL_VERIFY | PASSWORD_RESET | INVITE
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([identifier, type])
  @@index([expiresAt])
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique // "Editor"
  slug        String  @unique // "editor"
  description String?
  isSystem    Boolean @default(false) // cannot be deleted from the admin UI

  permissions RolePermission[]
  users       UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id      String @id @default(cuid())
  key     String @unique // "exam:publish"
  subject String // "exam"
  action  String // "publish"

  roles RolePermission[]

  @@index([subject])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

/// Append-only. RANGE-PARTITIONED BY MONTH on createdAt, hence the composite PK.
/// Answers "who touched what, when, from where" — including deletes, logins and
/// bulk imports, which have no revision. Complements ContentRevision, which
/// answers "what did this page look like".
model AuditLog {
  id            BigInt      @default(autoincrement())
  actorId       String?
  action        AuditAction
  ownerType     OwnerType
  ownerId       String
  changedFields String[]
  before        Json?
  after         Json?
  ipHash        String?
  userAgent     String?
  requestId     String?
  createdAt     DateTime    @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@id([id, createdAt])
  @@index([ownerType, ownerId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model SavedItem {
  id        String    @id @default(cuid())
  userId    String
  ownerType OwnerType
  ownerId   String
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ownerType, ownerId])
  @@index([ownerType, ownerId])
}
