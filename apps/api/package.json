{
  "name": "@stc/api",
  "version": "0.1.0",
  "private": true,
  "description": "SchoolToCareer REST API - Express foundation.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "start:worker": "node dist/workers/worker.js",
    "dev:worker": "tsx watch src/workers/worker.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@stc/config": "workspace:*",
    "@stc/constants": "workspace:*",
    "@stc/database": "workspace:*",
    "@stc/types": "workspace:*",
    "@stc/utils": "workspace:*",
    "@stc/validation": "workspace:*",
    "cloudinary": "^2.5.1",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.3.5",
    "vitest": "^2.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
