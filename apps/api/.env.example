NODE_ENV=development
PORT=4000

# Keep the database in the same region as this service. No `pgbouncer=true` —
# see packages/database/.env.example for the measurement behind that.
DATABASE_URL="postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/schooltocareer?sslmode=require"
DIRECT_DATABASE_URL="postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/schooltocareer?sslmode=require"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="replace-me-at-least-32-characters-long"
JWT_REFRESH_SECRET="replace-me-at-least-32-characters-long"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rotating this resets rate-limit buckets and breaks download de-duplication.
IP_HASH_SALT="replace-me-16-chars-min"

REVALIDATE_SECRET="replace-me-at-least-24-characters"
# Where the web app is served. PRODUCTION MUST BE THE APEX DOMAIN:
#   WEB_BASE_URL="https://schooltocareer.in"
# Canonicals, sitemap URLs, og:url, JSON-LD @id and the IndexNow keyLocation
# are all derived from SITE.ORIGIN in @stc/constants, but the revalidation
# webhook and IndexNow host come from here.
WEB_BASE_URL="http://localhost:3000"
# Production: "https://schooltocareer.in,https://admin.schooltocareer.in"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
LOG_LEVEL=debug

# Optional. Absent -> in-memory cache provider.
# REDIS_URL=
